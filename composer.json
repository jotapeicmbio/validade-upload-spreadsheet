{
    "name": "icmbio/validate-upload-registers-from-spreadsheet",
    "description": "validate upload registers from spreadsheet",
    "type": "library",
    "autoload": {
        "files": [
          "src/helpers/index.php"
        ],
        "psr-4": {
            "Icmbio\\ValidateRegister\\": "src/"
        }
    },
    "autoload-dev": {
      "psr-4": {
        "Tests\\ValidateRegister\\": "tests/"
      }
    },
    "authors": [
        {
            "name": "João Pedro Garcia",
            "email": "jotapegue09@gmail.com"
        },
        {
            "name": "Marcio Bastos Neves",
            "email": "marciobastosn@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "config": {
        "platform": {
            "php": "8.2.29"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "phpstan/phpstan": "2.2.x-dev",
        "friendsofphp/php-cs-fixer": "dev-master"
    },
    "require": {
        "phpoffice/phpspreadsheet": "5.7.0",
        "icmbio/validate-xpath-expression": "1.0.1",
        "ramsey/uuid": "4.9.2"
    },
        "scripts": {
        "test": "vendor/bin/phpunit --colors=always --testdox",
        "stan": "vendor/bin/phpstan analyse --memory-limit=1G --no-progress --debug",
        "style-check": "vendor/bin/php-cs-fixer check",
        "style-fix": "vendor/bin/php-cs-fixer fix --allow-risky=yes --diff --dry-run",
        "check": [
            "@stan",
            "@test",
            "@style-fix"
        ]
    }
}
